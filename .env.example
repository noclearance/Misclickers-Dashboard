# Misclickerz Discord Bot & Venny Integration Config
# Server listen port (Render injects PORT automatically in production)
PORT=3000

# Secret key for authenticating requests between Venny bot and this web hub
VENNY_API_KEY=your_venny_secret
VITE_VENNY_API_KEY=your_venny_secret

# Comma-separated Discord ROLE IDs (snowflakes) that unlock staff-only hub controls.
# Example: VITE_STAFF_ROLE_IDS=123456789012345678,234567890123456789
# Leave empty to disable staff mode for everyone.
VITE_STAFF_ROLE_IDS=

# ---------------------------------------------------------------------------
# Discord OAuth2 member login (hub-owned code→token exchange)
# Reuse the EXISTING Misclickerz Venny Discord application — do NOT create a new app.
# DISCORD_CLIENT_ID  = Venny application CLIENT_ID (same as Venny)
# DISCORD_CLIENT_SECRET = OAuth2 client secret from Discord Developer Portal
#   (this is NOT the bot token and NOT VENNY_API_KEY / API_TOKEN)
# DISCORD_REDIRECT_URI must exactly match a Redirect added on that Venny app
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://misclickerz-hub.onrender.com/auth/discord/callback

# Signs the httpOnly hub_session cookie (required in production)
SESSION_SECRET=

# Bot guild-member lookup (existing) — used after /users/@me to resolve roleIds
# and prove the user is in the Misclickerz guild. Do NOT use guilds.members.read
# on the user OAuth token for v1.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Wise Old Man (WOM) Configuration
WOM_GROUP_ID=24942
WOM_API_KEY=

# Optional Venny clan/now bridge
# VENNY_CLAN_NOW_URL=
